{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "求职助手",
  "version": "0.3.0-dev.1",
  "identifier": "com.xdl1234.job-search-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "求职助手",
        "width": 1380,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": { "active": false }
}
