{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "求职助手",
  "version": "1.0.0",
  "identifier": "com.xdl1234.job-search-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "求职助手 · 1.0.0",
        "decorations": false,
        "width": 1380,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["msi", "nsis"],
    "publisher": "XDL1234",
    "homepage": "https://github.com/XDL1234/job-search-assistant",
    "shortDescription": "管理求职资料、公司网申和 BOSS 直聘投递任务",
    "useLocalToolsDir": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": {"type": "embedBootstrapper", "silent": true},
      "allowDowngrades": false,
      "wix": {"language": "zh-CN", "upgradeCode": "be640d04-d188-5c53-8812-748708c7189c"},
      "nsis": {"installMode": "currentUser", "languages": ["SimpChinese"], "displayLanguageSelector": false, "startMenuFolder": "求职助手", "installerIcon": "icons/icon.ico"}
    }
  }
}
